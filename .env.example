# Все переменные читаются с префиксом PORTAL_ (см. app/config.py).
# Скопируйте этот файл в .env и при необходимости поменяйте значения.

# Имя приложения — отображается в заголовке страниц и в OpenAPI
PORTAL_APP_NAME=Семейный портал здоровья

# Режим отладки (true/false)
PORTAL_DEBUG=false

# Путь к файлу базы данных SQLite (каталог создаётся автоматически)
PORTAL_DATABASE_PATH=data/app.sqlite3

# --- Хранилище медицинских документов (сканов) ---
# Бэкенд: local (файлы на диске) или smb (портал сам подключается к шаре).
PORTAL_DOCUMENTS_BACKEND=local

# local: корень-каталог с документами и каталог «входящих» (неразобранных сканов).
PORTAL_DOCUMENTS_ROOT=data/documents
PORTAL_DOCUMENTS_INBOX=data/inbox

# smb: портал подключается сам, монтировать в ОС НЕ нужно. Заполнить при BACKEND=smb.
PORTAL_SMB_HOST=192.168.1.72
PORTAL_SMB_SHARE=scans
PORTAL_SMB_ROOT=analizy
PORTAL_SMB_USER=family
PORTAL_SMB_PASSWORD=

# Хост и порт для uvicorn (используются в `make run`)
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8000
